{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SandboxRun.v1",
  "description": "One sandbox run session.",
  "type": "object",
  "required": [
    "schema_version",
    "sandbox_run_id",
    "target_repo",
    "source_ref",
    "workspace_path",
    "agent_lanes",
    "started_at",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "SandboxRun.v1"},
    "sandbox_run_id": {"type": "string", "pattern": "^SR-[A-Za-z0-9_\\-]+$"},
    "target_repo": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "workspace_path": {"type": "string", "minLength": 1, "maxLength": 1024},
    "agent_lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "edge_case",
          "chaos",
          "mutation",
          "reproduction",
          "classification",
          "gate",
          "patch_advisor",
          "receipt"
        ]
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {"type": "string", "enum": ["running", "completed", "failed", "aborted"]},
    "receipt_count": {"type": "integer", "minimum": 0}
  }
}
