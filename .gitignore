# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Packaging / build metadata
*.egg-info/
build/
dist/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Sandbox runtime output — all regenerated by scripts/run_sandbox_once.sh
# (the demo regenerates receipts before verify/replay use them). The demo
# *target* source lives under sandbox-targets/, which stays tracked.
sandbox/workspaces/
sandbox/runs/
sandbox/receipts/
sandbox/reports/

# Local CI gate evidence (regenerated by scripts/ci_gate.sh, uploaded as a
# CI artifact — not source).
reports/failureforge-verification/

# Generated aggregate doc (built from doc/system/*.md by doc/system/BUILD.sh;
# embeds a build timestamp, so it churns every run). Source of truth is
# doc/system/*.md.
doc/FFGSYSTEM.md

# Virtualenvs / local env
.venv/
venv/
.env
